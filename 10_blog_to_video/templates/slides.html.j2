      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      position: relative;
      overflow: hidden;
    }
    .layout-principles .card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 6px;
      background: var(--accent);
    }
    .layout-principles .card .num {
      font-size: 110px;
      font-weight: 800;
      line-height: 1;
      color: var(--accent-soft);
      letter-spacing: -0.04em;
      margin-bottom: -10px;
    }
    .layout-principles .card .ico {
      position: absolute;
      top: 36px; right: 36px;
      width: 56px; height: 56px;
      border-radius: 14px;
      background: var(--accent-soft);
      display: flex; align-items: center; justify-content: center;
