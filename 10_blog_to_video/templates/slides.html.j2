<body class="theme-{{ theme | default('studio-clean') }}">
{% for slide in slides %}
  {# loop.index 不会自动传进 include，用 set 显式传 #}
  {% set page_num = loop.index %}
  {% set total_pages = slides|length %}
  {% include "layouts/" ~ (slide.layout | replace("-", "_")) ~ ".html.j2" %}
{% endfor %}

<script>
  // Mermaid 中文字体，避免渲染时变方框
  if (window.mermaid) {
    mermaid.initialize({
      startOnLoad: true,
      theme: 'base',
      themeVariables: {
        background: 'transparent',
        primaryColor: '#101c30',
        primaryBorderColor: '#31d6ff',
        primaryTextColor: '#f4f7fb',
        secondaryColor: '#171431',
        secondaryBorderColor: '#b58cff',
        tertiaryColor: '#0b1322',
        lineColor: '#7da7ff',
        textColor: '#f4f7fb',
        clusterBkg: '#0b1322',
        clusterBorder: '#263650',
        fontFamily: '"PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif'
      },
      themeCSS: '.mermaid, .mermaid * { font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif !important; font-size: 28px; } .mermaid .node rect, .mermaid .node polygon { rx: 6px; ry: 6px; filter: drop-shadow(0 12px 24px rgba(0,0,0,0.32)); } .mermaid .edgePath .path { stroke-width: 2.8px; } .mermaid .arrowheadPath { fill: #7da7ff; stroke: #7da7ff; }',
      flowchart: { curve: 'basis', padding: 28, nodeSpacing: 70, rankSpacing: 86 },
    });
  }
  // Lucide：把 <i data-lucide="shield"> 替换成 <svg>
  if (window.lucide) {
    lucide.createIcons();
  }
  // highlight.js：扫所有 <pre><code class="language-X"> 上色
  if (window.hljs) {
    hljs.highlightAll();
  }
  // 截图层（03_render.py）会等这两个标记出现再截
  document.body.setAttribute('data-render-ready', 'true');
</script>
</body>
</html>
