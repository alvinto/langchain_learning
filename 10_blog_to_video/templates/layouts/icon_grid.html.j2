<section class="slide layout-icon-grid" data-page="{{ page_num }}">
  <div class="accent-bar"></div>
  <h2 class="h-title">{{ slide.title }}</h2>
  <div class="grid cols-{{ slide['items']|length }}">
    {% for it in slide['items'] %}
    <div class="card">
      <div class="icon-wrap"><i data-lucide="{{ it.icon }}"></i></div>
      <div class="name">{{ it.name }}</div>
      <div class="desc">{{ it.desc }}</div>
    </div>
    {% endfor %}
  </div>
  <div class="page-num">{{ "%02d"|format(page_num) }} / {{ total_pages }}</div>
</section>
