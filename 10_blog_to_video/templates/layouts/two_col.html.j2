<section class="slide layout-two-col" data-page="{{ page_num }}">
  <div class="accent-bar"></div>
  <h2 class="h-title">{{ slide.title }}</h2>
  <div class="wrap">
    <div class="left">
      <ul class="bullet-list">
        {% for p in slide.points %}<li>{{ p }}</li>{% endfor %}
      </ul>
    </div>
    <div class="right">{{ slide.body | hl(slide.highlights) }}</div>
  </div>
  <div class="page-num">{{ "%02d"|format(page_num) }} / {{ total_pages }}</div>
</section>
