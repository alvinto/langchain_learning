<section class="slide layout-roadmap" data-page="{{ page_num }}">
  <div class="accent-bar"></div>
  <h2 class="h-title">{{ slide.title }}</h2>
  <div class="road">
    {% for s in slide.steps %}
    <div class="step">
      <div class="n">{{ loop.index }}</div>
      <div class="label">{{ s.label }}</div>
    </div>
    {% endfor %}
  </div>
  <div class="page-num">{{ "%02d"|format(page_num) }} / {{ total_pages }}</div>
</section>
