# ============================================================
# 复制为 .env 后修改，所有 demo 都通过 _common.py 自动读取
# ============================================================

# ----- 主 LLM（必填） -----
# 默认走 DeepSeek（国内可直连、便宜）；换提供方时改这三行即可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-REPLACE-WITH-YOUR-KEY
LLM_MODEL=deepseek-chat

# ----- Embedding（RAG 章节必填） -----
# DeepSeek 没有自己的 Embedding，推荐 DashScope 或 OpenAI。
# 留空时会回退到上面的 LLM_* 配置。
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-REPLACE-WITH-YOUR-KEY
EMBED_MODEL=text-embedding-v3

# ----- LangSmith 追踪（可选，强烈推荐） -----
# 填了 LANGCHAIN_API_KEY 后，跑任何 demo 都会自动把提示词、tool_calls、
# token 用量上报到 https://smith.langchain.com —— 学 Agent 时几乎是必备的
# 调试工具，能看到每一次模型调用前后的完整上下文。
#
# 操作：去 https://smith.langchain.com 注册 → Settings → API Keys 申请一个
# 个人 key，粘贴到下面那行（去掉 # 注释）即可。不填 → 完全无影响。
#
# LANGCHAIN_API_KEY=lsv2_pt_xxx
# LANGCHAIN_PROJECT=langchain_learning
#
# 高级：如果你想临时关掉追踪（但保留 key），设下面这行。默认不设即开启。
# LANGCHAIN_TRACING_V2=false
