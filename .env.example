# ============================================================
# 复制为 .env 后修改，所有 demo 都通过 _common.py 自动读取
# ============================================================

# ----- 主 LLM（必填） -----
# 默认走 DeepSeek（国内可直连、便宜）；换提供方时改这三行即可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-REPLACE-WITH-YOUR-KEY
LLM_MODEL=deepseek-chat

# ----- Embedding（RAG 章节必填） -----
# DeepSeek 没有自己的 Embedding，推荐 DashScope 或 OpenAI。
# 留空时会回退到上面的 LLM_* 配置。
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-REPLACE-WITH-YOUR-KEY
EMBED_MODEL=text-embedding-v3

# ----- LangSmith 追踪（可选，强烈推荐） -----
# 填了 LANGCHAIN_API_KEY 后，跑任何 demo 都会自动把提示词、tool_calls、
# token 用量上报到 https://smith.langchain.com —— 学 Agent 时几乎是必备的
# 调试工具，能看到每一次模型调用前后的完整上下文。
#
# 操作：去 https://smith.langchain.com 注册 → Settings → API Keys 申请一个
# 个人 key，粘贴到下面那行（去掉 # 注释）即可。不填 → 完全无影响。
#
# LANGCHAIN_API_KEY=lsv2_pt_xxx
# LANGCHAIN_PROJECT=langchain_learning
#
# 高级：如果你想临时关掉追踪（但保留 key），设下面这行。默认不设即开启。
# LANGCHAIN_TRACING_V2=false

# ----- Deep Research 搜索后端（09 章用，可选） -----
# 主搜索后端用 Tavily：注册 https://tavily.com，免费 1000 次/月，结果适合 Agent 消费。
# 不填也能跑，会自动降级到 DuckDuckGo（免 key 但结果一般、偶尔限流）。
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# ----- Deep Research 模型分层（09 章 v2，可选） -----
# 不设 → 全部用 LLM_MODEL，不影响功能。
# 设了 → multi-agent 不同节点用不同档位，省钱 + 提速 + 提质。
# 推荐配置示例（DeepSeek）：
#   LLM_MODEL_SMART=deepseek-chat          # supervisor 决策、researcher 探索
#   LLM_MODEL_WRITER=deepseek-chat         # 最终报告
#   LLM_MODEL_CHEAP=deepseek-chat          # 总结/压缩（DeepSeek 一档就够便宜）
# 推荐配置示例（混搭 OpenAI / DeepSeek，更进阶）：
#   LLM_MODEL_SMART=gpt-4.1                # 决策路径
#   LLM_MODEL_WRITER=gpt-4.1
#   LLM_MODEL_CHEAP=gpt-4.1-mini           # 摘要类粗活
# LLM_MODEL_SMART=
# LLM_MODEL_WRITER=
# LLM_MODEL_CHEAP=

# ----- Deep Research 行为参数（09 章 v2，可选） -----
# supervisor 模式下最多决策轮数（每轮可并发多个 researcher）。默认 3 够大部分问题。
# RESEARCH_MAX_ITERATIONS=3
# 默认运行模式：supervisor（动态调度）/ simple（一次性 planner）
# RESEARCH_MODE=supervisor
